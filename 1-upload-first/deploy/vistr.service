# Runs the Vistr game server on Linux (Ubuntu, Debian ...), starts it at boot and
# restarts it if it stops.
#
#   sudo cp deploy/vistr.service /etc/systemd/system/vistr.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now vistr
#   sudo systemctl status vistr          # check it is running
#   sudo journalctl -u vistr -f          # watch its log
#
# Assumes the project is in /opt/vistr and a user called "vistr" owns it
# (see README section 5). Change the paths below if yours differ.
[Unit]
Description=Vistr word game server
After=network-online.target
Wants=network-online.target

[Service]
User=vistr
WorkingDirectory=/opt/vistr
ExecStart=/usr/bin/node server/server.js
Restart=always
RestartSec=3
# Only nginx/Caddy on this machine talk to the game server; they add HTTPS.
Environment=HOST=127.0.0.1
Environment=PORT=3000
# Player data lives here and survives restarts and updates. Back this folder up.
Environment=VISTR_DB=/var/lib/vistr/db.json
# Password for admin.html (messages, reviews) and ad stats. Change it.
Environment=ADMIN_KEY=change-me
# Optional, with a free Resend account (https://resend.com): email new players their ID,
# and forward contact-form messages to your inbox. Your address stays on the server only.
#Environment=RESEND_API_KEY=re_xxx
#Environment=MAIL_FROM=Vistr <play@yourdomain.com>
#Environment=CONTACT_TO=you@yourdomain.com
StateDirectory=vistr

[Install]
WantedBy=multi-user.target
