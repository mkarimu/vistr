# Caddy in front of the Vistr game server: the simplest option, because Caddy
# gets and renews the HTTPS certificate by itself.
#
#   Replace play.example.com with your domain, then:
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
play.example.com {
	reverse_proxy 127.0.0.1:3000 {
		# send live game events straight through, unbuffered
		flush_interval -1
	}
}
